# Copy to .env and fill in. Never commit .env.

# --- backend (Anvi)
ANTHROPIC_API_KEY=
LLM_MODE=mock
DATABASE_URL=sqlite:///./labellock.db
SIM_DATABASE_URL=sqlite:///./sim.db
SIM_API_KEY=dev-sim-key
AUTH_SECRET=dev-only-change-me
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173
# chrome-extension://<extension id>, added to CORS for the Gmail side panel
EXTENSION_ORIGIN=
UPLOAD_DIR=./uploads

# --- frontend (Khanak)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCKS=true

# --- Gmail extension (Khanak, P1)
EXT_OAUTH_CLIENT_ID=
EXT_API_BASE_URL=http://localhost:8000/api
