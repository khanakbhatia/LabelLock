# Copy to .env and fill in. Never commit .env.

# --- backend (Anvi)
ANTHROPIC_API_KEY=
# mock (recorded fixtures) | live (Claude) | record (live, and save a fixture for mock)
LLM_MODE=mock
LLM_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./labellock.db
SIM_DATABASE_URL=sqlite:///./sim.db
SIM_API_KEY=dev-sim-key
AUTH_SECRET=dev-only-change-me
DEMO_MODE=true
# where backend adapters reach /sim/* (same server by default)
SIM_BASE_URL=http://localhost:8000
# Khanak's dataset; falls back to backend/tests/fixtures/seed_stub when missing or incomplete
# SEED_DIR defaults to <repo>/data/seed
CORS_ORIGIN=http://localhost:5173
# chrome-extension://<extension id>, added to CORS for the Gmail side panel
EXTENSION_ORIGIN=
UPLOAD_DIR=./uploads

# --- frontend (Khanak)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCKS=true

# --- Gmail extension (Khanak, P1)
EXT_OAUTH_CLIENT_ID=
EXT_API_BASE_URL=http://localhost:8000/api
