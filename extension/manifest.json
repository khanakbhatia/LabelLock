{
  "manifest_version": 3,
  "name": "LabelLock Gmail Side Panel",
  "version": "0.1.0",
  "description": "Review supplier emails in LabelLock beside Gmail.",
  "key": "",
  "permissions": ["sidePanel", "identity", "storage"],
  "host_permissions": ["https://mail.google.com/*", "https://gmail.googleapis.com/*", "http://localhost:8000/*"],
  "oauth2": {
    "client_id": "1004816944321-h8p5u1g2it8sj8akjojaps90k31fd1f7.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open LabelLock beside Gmail" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
